{
  "name": "dsh-plugin-branch-origin",
  "version": "0.1.2",
  "description": "分支联系：给 DSH 里分叉出来的会话标上它来自哪个对话 —— 标题带上「⤷ 来源：<源会话标题>」，侧栏行另有一个不受改名影响的来源徽标。零依赖、无构建链。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test --test-isolation=none \"tests/*.test.mjs\" && node tests/client-smoke.mjs",
    "test:isolated": "node --test \"tests/*.test.mjs\"",
    "client-smoke": "node tests/client-smoke.mjs",
    "rm-test": "node --import ./test/register.mjs .verify/real-machine.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
